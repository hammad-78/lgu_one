rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Lost & Found ─────────────────────────────────────────────────────────
    match /lost_found/{itemId}/{fileName} {
      allow read, write: if true;
    }

    // ─── Student profile photos ───────────────────────────────────────────────
    // One file per student: profile_photos/{uid}.jpg. Anyone can view; only the
    // owner can upload (image, under 2 MB) or delete their own photo.
    match /profile_photos/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.jpg'
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }

    // ─── Everything else ──────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
