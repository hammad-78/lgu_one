rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if false; // only Cloud Functions write here
    }

    match /lost_found_items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.secretKeyHash is string
                    && request.resource.data.secretKeyHash.size() == 64;
      allow update: if request.resource.data.secretKeyHash == resource.data.secretKeyHash
                    || (request.auth != null
                        && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if true;
    }

    match /collaborations/{collabId} {
      allow read: if true;
      allow create: if request.resource.data.info.secretKey is string
                    && request.resource.data.info.secretKey.size() > 0;
      allow update: if request.resource.data.info.secretKey == resource.data.info.secretKey;
      allow delete: if true;
    }

    match /device_tokens/{token} {
      allow read: if false;
      allow write: if true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    
    match /news/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /jobs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /admins/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
